{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fleetly:local:v1:schema:fleetly.local-registration-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "client_id",
    "accepted"
  ],
  "properties": {
    "schema": {
      "const": "fleetly.local-registration-result.v1"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "accepted": {
      "const": true
    }
  }
}
