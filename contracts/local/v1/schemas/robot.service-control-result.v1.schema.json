{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fleetly:local:v1:schema:robot.service-control-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ts",
    "result_seq",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "robot.service-control-result.v1"
    },
    "ts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "result_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "accepted",
        "running",
        "succeeded",
        "rejected",
        "failed",
        "expired"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 512
    }
  }
}
