{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fleetly:local:v1:schema:robot.services-status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ts",
    "services"
  ],
  "properties": {
    "schema": {
      "const": "robot.services-status.v1"
    },
    "ts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "services": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "status",
          "substatus",
          "available_actions"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]{0,119}\\.service$",
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "pattern": "^[a-z][a-z-]{0,31}$"
          },
          "substatus": {
            "type": "string",
            "pattern": "^[a-z][a-z-]{0,63}$"
          },
          "available_actions": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "start",
                "stop",
                "restart"
              ]
            }
          }
        }
      }
    }
  }
}
